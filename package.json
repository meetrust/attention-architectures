{
  "name": "attention-architectures",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "大模型 Attention 架构与技术路线对照 · An interactive atlas of attention architectures in 11 Chinese LLM families",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview --port 4173",
    "check": "node scripts/check-data.mjs",
    "lint": "eslint src",
    "build:artifact": "tsc --noEmit -p . && vite build --mode artifact && node scripts/inline-artifact.mjs"
  },
  "dependencies": {
    "@cloudflare/kumo": "2.18.1",
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@phosphor-icons/react": "2.1.10",
    "lucide-react": "1.71.0",
    "motion": "12.43.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8"
  }
}
